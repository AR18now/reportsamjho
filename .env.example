# Copy this file to .env and fill in your values. Never commit .env.
# Option A (default): Groq cloud API
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Option B: fully local with Ollama (no data leaves your computer)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
