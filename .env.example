# Copy this file to .env and fill in your values. Never commit .env.
# Option A (default): OpenRouter cloud API, free Liquid LFM 2.5 (2.6B)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=liquid/lfm-2.5-2.6b:free

# Option B: fully local with Ollama (no data leaves your computer)
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b
